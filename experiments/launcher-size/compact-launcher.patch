+/* Size experiment: bounded fields replace the general formatter. */
+static void format_line(const char *prefix, const char *text, uint8_t width)
+{
+    char *out = linebuffer;
+    while (*prefix) *out++ = *prefix++;
+    while (width--) *out++ = *text ? *text++ : ' ';
+    *out++ = ' ';
+    *out = 0;
+}
+static void print_hex(uint8_t value)
+{
+    static const char digits[] = "0123456789abcdef";
+    if (value >= 16) cputc(digits[value >> 4]);
+    cputc(digits[value & 15]);
+}
