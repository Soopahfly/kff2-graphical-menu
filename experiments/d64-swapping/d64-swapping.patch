+        }
+    }

     // BASIC commands to run are placed in KFF_BUF
     u8 cmd = CMD_MOUNT_DISK;
     while (true)
     {
-        u8 reply = disk_send_command(cmd, channels);
+        swap.busy = talk || listen;
+        u8 reply = disk_send_command(cmd, channels, &swap);
