+        if (swap->flashes)
+        {
+            unsigned phase = (TIM2->CNT - swap->feedback_start) / 1000;
+            if (phase < swap->flashes * 2)
+            {
+                C64_CRT_CONTROL(phase & 1 ? STATUS_LED_OFF : STATUS_LED_ON);
+                continue;
+            }
+            swap->flashes = 0;
+            C64_CRT_CONTROL(led_status);
+        }
         if (timer_elapsed())
