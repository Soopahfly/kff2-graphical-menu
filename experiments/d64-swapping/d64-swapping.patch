+#!/usr/bin/env python3
+"""Compile the real D64 disk-set code and FatFs with a RAM-backed test card."""
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+firmware = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else root / "firmware"
+with tempfile.TemporaryDirectory(prefix="kff2-disk-set-") as temp:
+    work = Path(temp)
+    fs = work / "fatfs"
+    shutil.copytree(firmware / "fatfs", fs)
+    conf = fs / "ffconf.h"
+    conf.write_text(conf.read_text().replace("#define FF_USE_MKFS\t\t0", "#define FF_USE_MKFS\t\t1"))
+    conf.write_text(conf.read_text().replace("#define FF_USE_CHMOD\t0", "#define FF_USE_CHMOD\t1"))
+    env = os.environ.copy()
+    env.pop("C_INCLUDE_PATH", None)
+    env["ASAN_OPTIONS"] = "detect_leaks=0"
+    executable = work / "disk-set"
+    subprocess.run([
+        "gcc", "-std=c11", "-O1", "-g", "-Wall", "-Wextra", "-Werror",
+        "-Wno-unused-function", "-Wno-unused-variable", "-Wno-unused-parameter",
+        "-fsanitize=address,undefined", "-no-pie",
+        "-I", str(fs), "-I", str(firmware), str(Path(__file__).with_suffix(".c")),
+        str(fs / "ff.c"), str(fs / "ffunicode.c"), "-o", str(executable),
+    ], env=env, check=True)
+    subprocess.run([executable], env=env, check=True)
