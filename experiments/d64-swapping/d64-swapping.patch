+
+static DISK_SET disk_set;
+static D64_IMAGE disk_set_spare;
+
+static void disk_swap_clock_start(void)
+{
+    /* APB1 is HCLK/2. Its timer clock is HCLK with the default TIMPRE. */
+    SET_BIT(RCC->APB1LENR, RCC_APB1LENR_TIM2EN);
+    (void)RCC->APB1LENR;
+    SET_BIT(RCC->APB1LRSTR, RCC_APB1LRSTR_TIM2RST);
+    CLEAR_BIT(RCC->APB1LRSTR, RCC_APB1LRSTR_TIM2RST);
+    TIM2->PSC = SystemCoreClock / 10000 - 1;
+    TIM2->EGR = TIM_EGR_UG;
+    TIM2->CR1 = TIM_CR1_CEN;
+}
+
+static void disk_poll_swap(DISK_SWAP_STATE *swap, u8 cmd, DISK_CHANNEL *channels)
+{
+    /* The prescaler ticks at 10 kHz. Use unsigned tick differences across wrap. */
+    u32 now = TIM2->CNT;
+    unsigned action = disk_set_button(&swap->button,
+        (C64_CONTROL_READ() & SPECIAL_BTN) != 0, now);
+    if (action)
+    {
+        bool ok = cmd == CMD_NONE && !swap->busy && disk_swap_channels_idle(channels);
+        if (ok)
+        {
+            D64_IMAGE *old = swap->image;
+            ok = disk_set_swap(&disk_set, &swap->image, &swap->spare, action);
+            if (ok && old != swap->image)
+            {
+                disk_init_all_channels(swap->image, channels);
+                disk_last_error = DISK_STATUS_OK;
+            }
+        }
+
+        swap->flashes = ok ? 1 : 3;
+        swap->feedback_start = TIM2->CNT;
+        timer_start_ms(175);  // SD I/O uses the shared SysTick timer.
+    }
+}
+
+static u8 disk_send_command(u8 cmd, DISK_CHANNEL *channels, DISK_SWAP_STATE *swap)
 {
     c64_set_command(cmd);

